# swim.env — Configuration for your SWIM GitOps deployment
# Copy this file to config/swim.env and fill in the values.
# config/swim.env is listed in .gitignore — never commit it.
#
# USAGE:
#   cp config/swim.env.example config/swim.env
#   # Edit config/swim.env with your values
#   source config/swim.env
#   make ci-install-crc          # CRC with internal registry + Gitea
#   # OR
#   make ci-install              # External registry (Quay.io, etc.)

# ── Git server ──────────────────────────────────────────────────────────────
# URL of the Git repository that Argo CD reads for GitOps.
# For CRC local:  http://gitea-http.gitea.svc.cluster.local:3000/swimadmin/swim-gitops.git
# For production: https://github.com/<your-org>/swim-gitops.git
#                 https://gitlab.example.com/<your-org>/swim-gitops.git
SWIM_GIT_URL=http://gitea-http.gitea.svc.cluster.local:3000/swimadmin/swim-gitops.git

# ── Gitea (for CRC local only) ───────────────────────────────────────────────
GITEA_ROUTE=https://gitea.apps-crc.testing
GITEA_ADMIN_USER=swimadmin
GITEA_ADMIN_PASS=Swim@Local1
# API token (generated by: make gitea-init, or manually in Gitea UI)
SWIM_RELEASE_TOKEN=

# ── Container image registry ────────────────────────────────────────────────
# For CRC local (internal OpenShift registry):
#   image-registry.openshift-image-registry.svc:5000/swim-demo
# For Quay.io:
#   quay.io/<your-username>
# For production OpenShift internal:
#   image-registry.openshift-image-registry.svc:5000/<your-namespace>
SWIM_IMAGE_REGISTRY=image-registry.openshift-image-registry.svc:5000/swim-demo

# ── Quay.io credentials (only if SWIM_IMAGE_REGISTRY points to quay.io) ────
QUAY_USER=
QUAY_TOKEN=

# ── Namespace ───────────────────────────────────────────────────────────────
SWIM_NAMESPACE=swim-demo
SWIM_PIPELINE_NAMESPACE=swim-pipeline
